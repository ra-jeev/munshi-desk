APP_URL=http://localhost:8080
# Local or hosted PostgreSQL. Keep real values in ignored .env or host secrets.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/munshi_desk
MUNSHI_TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/munshi_desk_test
BETTER_AUTH_SECRET=
# Meta uses the OpenAI-compatible engine. Keep OpenAI realtime disabled here.
AGENT_ENGINE=munshi-meta
AGENT_MODEL=muse-spark-1.3
OPENAI_BASE_URL=https://api.meta.ai/v1
OPENAI_API_KEY=
# Dictation resolves this separate scoped key.
META_API_KEY=
